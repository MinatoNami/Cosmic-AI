# Copy this file to .env and adjust the values.
# Anything set here is available to config.yaml as ${VAR_NAME}, and to
# docker compose. Remove a line to fall back to the default in config.yaml.

# Database Configuration
# DB_HOST is the hostname of the database server: "db" is the service name
# used by docker compose. Set it to "localhost" when running the server
# directly against a database on your own machine.
DB_HOST=db
DB_PORT=3306
DB_NAME=cosmic
DB_USER=root
DB_PASS=
