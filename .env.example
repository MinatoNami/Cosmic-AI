# Copy this file to .env and adjust the values.
# Anything set here is available to config.yaml as ${VAR_NAME}, and to
# docker compose. Remove a line to fall back to the default in config.yaml.

# Database Configuration
# DB_HOST is the hostname of the database server: "db" is the service name
# used by docker compose. Set it to "localhost" when running the server
# directly against a database on your own machine.
DB_HOST=db
DB_PORT=3306
DB_NAME=cosmic
DB_USER=root
DB_PASS=

# Characters whose play the server records for the AI agents to learn from, comma-separated,
# or * for every human player (any account not in DEMONSTRATION_BOT_ACCOUNTS, which
# defaults to the agents' own: agent*,asker,watcher).
# Recordings go to agents-data/demonstrations/<name>/, one file per login.
DEMONSTRATION_CHARACTERS=
